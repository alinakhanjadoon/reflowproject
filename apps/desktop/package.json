{
  "name": "reflow-desktop",
  "productName": "ReFlow Desktop",
  "version": "1.0.0",
  "description": "ReFlow Desktop Local Automation Runner & Chrome Engine",
  "main": "src/main/main.js",
  "author": "ReFlow",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --x64 --publish never",
    "build:mac:zip": "electron-builder --mac zip --x64 --publish never",
    "build:mac:dmg": "electron-builder --mac dmg --x64 --publish never",
    "build:all": "node scripts/build-all.js",
    "dist": "electron-builder --publish never",
    "test": "node test/test-http-bridge.js"
  },
  "build": {
    "appId": "com.reflow.desktop",
    "productName": "ReFlow Desktop",
    "electronVersion": "33.2.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/engine",
        "to": "engine",
        "filter": [
          "src/**/*",
          "package.json"
        ]
      }
    ],
    "protocols": [
      {
        "name": "ReFlow Desktop Protocol",
        "schemes": [
          "reflow"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReFlow Desktop",
      "artifactName": "ReFlow-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ReFlow-Desktop-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "ReFlow-Desktop-${version}-mac-x64.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version} (Intel x64)",
      "artifactName": "ReFlow-Desktop-Setup-${version}-mac-x64.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "puppeteer-core": "22.15.0"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^26.15.3"
  }
}
